    "colorjs.io": "^0.7.1",
    "dexie": "^4.4.7",
    "dompurify": "^3.3.1",
    "entities": "^8.1.0",
    "fflate": "^0.8.2",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.60.0",
    "lz-string": "^1.5.0",
    "marked": "^18.1.1",
    "postcss": "^8.5.31",
    "postcss-value-parser": "^4.2.0",
